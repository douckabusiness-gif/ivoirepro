# Copy this file to .env.production on the VPS. Never commit the real file.

# Public application identity
APP_DOMAIN="ivoireci.com"
APP_URL="https://ivoireci.com"
ACME_EMAIL="admin@ivoireci.com"

# PostgreSQL credentials used only inside the private Docker network.
# Use a long URL-safe password so DATABASE_URL does not require escaping.
POSTGRES_USER="ivoirepro"
POSTGRES_PASSWORD="CHANGE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD"
POSTGRES_DB="ivoirepro"
DATABASE_URL="postgresql://ivoirepro:CHANGE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD@db:5432/ivoirepro?schema=public"

# Authentication and first administrator account
JWT_SECRET="CHANGE_WITH_AT_LEAST_64_RANDOM_CHARACTERS"
# Keep these only until the first administrator is created and its password is
# changed from /admin > Paramètres > Sécurité du Compte, then remove both lines.
ADMIN_DEFAULT_EMAIL="admin@ivoireci.com"
ADMIN_DEFAULT_PASSWORD="CHANGE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD"

# Optional server-side AI keys. They can also be configured from the admin.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
GLM_API_KEY=""

# Secret exigé par /api/cron/daily-report (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="CHANGE_WITH_A_LONG_RANDOM_CRON_SECRET"
