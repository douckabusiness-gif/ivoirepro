# Base de données PostgreSQL (Prisma)
# Pour le développement local (hors Docker) :
DATABASE_URL="postgresql://postgres:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5434/boutique_db?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_DB_PASSWORD"
POSTGRES_DB="boutique_db"

# Clé secrète pour les tokens et sessions Admin
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_LOCAL_SECRET"

# Active les connexions de démonstration uniquement en développement local
ENABLE_DEMO_MODE="true"

# Compte administrateur initial (obligatoire pour un premier démarrage)
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="CHANGE_ME_WITH_A_LOCAL_ADMIN_PASSWORD"

# URL de l'application
APP_URL="http://localhost:3000"

# GEMINI_API_KEY (Optionnel pour les fonctionnalités IA de rédaction)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
GLM_API_KEY=""

# Secret exigé par /api/cron/daily-report (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="CHANGE_WITH_A_LONG_RANDOM_CRON_SECRET"
