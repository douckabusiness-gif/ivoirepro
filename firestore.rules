rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Store settings: readable by all, writable by authenticated admin or store manager
    match /store/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Products: readable by everyone, writable by admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: readable by everyone, writable by admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: createable by customers, readable and updateable by admin
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
